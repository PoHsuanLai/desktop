# What the jail hides from the code it runs, relative to the real home folder. The jail otherwise shows the whole
# host read-only (cargo's registry, the toolchains and the sibling checkouts live there), so these places, where a
# person keeps keys and tokens, are covered by an empty folder (d) or an empty file (f) when they exist. Read by
# harness/jail.sh, and checked inside the jail by harness/selftest.sh. Add a line for a place that holds a secret;
# a place that does not exist on a machine is skipped. This is a list of known places, not a guarantee: the full
# fix is to show the jail only what a lane needs (FINDINGS, ROOT-18).
d .ssh
d .gnupg
d .aws
d .kube
d .docker
d .password-store
d .claude
d .grok
d .config/gh
d .config/glab-cli
d .config/gcloud
d .config/quire-release
d .local/share/keyrings
d .local/share/kwalletd
f .netrc
f .git-credentials
f .npmrc
f .pypirc
f .cargo/credentials
f .cargo/credentials.toml
f .config/git/credentials
d .azure
d .oci
d .mozilla
d .config/google-chrome
d .config/chromium
d .config/BraveSoftware
d .config/rclone
d .config/doctl
d .config/op
d .config/1Password
d .config/Bitwarden
d .terraform.d
f .vault-token
f .config/hub
f .huggingface/token
f .cache/huggingface/token
